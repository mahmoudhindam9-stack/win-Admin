{
  "name": "windows-performance-optimizer-suite",
  "private": true,
  "version": "2.7.0",
  "description": "Enterprise-grade Windows PowerShell and Batch automation scripts with live hardware telemetry, elevated UAC execution, and Universal Router Management.",
  "author": "Windows Performance Optimizer Suite",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "patch:ps": "node scripts/patch-powershell-generator.cjs",
    "build:win": "npm run patch:ps && npm run build && electron-builder --win",
    "build:dir": "npm run patch:ps && npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.optimizer.suite",
    "productName": "Windows Performance Optimizer Suite",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis", "icon": "buildResources/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Windows Performance Optimizer Suite",
      "license": "LICENSE.txt",
      "runAfterFinish": true,
      "installerIcon": "buildResources/icon.ico",
      "uninstallerIcon": "buildResources/icon.ico",
      "installerSidebar": "buildResources/installerSidebar.bmp",
      "uninstallerSidebar": "buildResources/installerSidebar.bmp"
    },
    "publish": [{ "provider": "github", "owner": "mahmoudhindam9-stack", "repo": "win-Admin", "releaseType": "release" }]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "systeminformation": "^5.33.8",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "wait-on": "^9.1.0"
  }
}
